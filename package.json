{
  "name": "orange-one-acpos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/release-source-lint.mjs",
    "test": "node --test tests/release/*.test.mjs",
    "test:e2e": "node scripts/release-http-e2e.mjs",
    "test:browser": "node scripts/release-browser-e2e.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm audit --audit-level=high && npm run build",
    "release:verify": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "next": "16.3.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
