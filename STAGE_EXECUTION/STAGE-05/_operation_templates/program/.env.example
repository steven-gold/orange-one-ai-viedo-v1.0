# ACPOS runtime contract. Never commit real credentials.

NEXT_PUBLIC_ACPOS_RUNTIME_MODE=
ACPOS_DEPLOYMENT_ENV=development
ACPOS_RELEASE_SHA=

# Local persistent sqlite. Neon is used when DATABASE_URL is set.
ACPOS_DATABASE_PATH=apps/api/data/acpos.sqlite

# Production database runtime contract. Values stay on Vercel/Neon.
# Driver package named by authority: @neondatabase/serverless
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=wild-wave-25661146
