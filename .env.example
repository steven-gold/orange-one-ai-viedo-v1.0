# ACPOS deployment environment contract.
# Never commit real credentials or provider secrets.

# Must be empty in production. CONTROLLED_TEST is validation-only and production-ineligible.
NEXT_PUBLIC_ACPOS_RUNTIME_MODE=

# Deployment metadata used by health endpoints and release operations.
ACPOS_DEPLOYMENT_ENV=production
ACPOS_RELEASE_SHA=

# Disable framework telemetry in production build/runtime when required by deployment policy.
NEXT_TELEMETRY_DISABLED=1
