name: Current v2.1.14 CORE ASSET Stage01 Stage02 Gate

on:
  push:
    branches: [rebuild-v2.1.1]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  v214-current-targeted-gate:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 1
      - name: Verify exact scope and single governance layer
        shell: bash
        run: |
          set -euo pipefail
          test "$GITHUB_REF_NAME" = "rebuild-v2.1.1"
          test -f governance/current/v2.1.14/EFFECTIVE_TEST_GOVERNANCE_MANIFEST.yaml
          test -f governance/current/v2.1.14/TEST_FEEDBACK_TEMPORARY_ARTIFACT_LIFECYCLE_DELTA.yaml
          grep -q 'target_pages: \[CORE-01, ASSET-01\]' GOVERNANCE_CURRENT.yaml
          grep -q 'version: v2.1.14' GOVERNANCE_CURRENT.yaml
      - name: Validate zero residual governance cleanup
        run: python governance/ci/validate_v214_zero_residual_cleanup.py
      - name: Run applicability-aware Stage-01 then Stage-02 truth classification
        run: python governance/ci/validate_targeted_stage01_stage02_v214.py
      - name: Upload targeted rerun result
        uses: actions/upload-artifact@v4
        with:
          name: targeted-stage01-stage02-v214-result
          path: 00_SOURCE_INTAKE/fresh_run_003/04_PAGE_FUNCTIONAL_CONTRACT/TARGETED_STAGE2_RERUN_V214_RESULT.json
          if-no-files-found: error
